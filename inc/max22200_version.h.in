 *
 * Do not edit the generated file: the version is set once, in cmake/max22200_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef MAX22200_VERSION_H
#define MAX22200_VERSION_H

/** Major version: incompatible API changes. */
#define MAX22200_VERSION_MAJOR @MAX22200_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define MAX22200_VERSION_MINOR @MAX22200_VERSION_MINOR@
/** Patch version: fixes. */
#define MAX22200_VERSION_PATCH @MAX22200_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define MAX22200_VERSION_STRING "@MAX22200_VERSION@"

#endif // MAX22200_VERSION_H
